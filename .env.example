# Copy to .env and edit. Every value here is optional — delete a line to keep
# the default. Loaded automatically if python-dotenv is installed, otherwise
# export the variables in your shell before starting the app.

# --- models (must already be pulled in Ollama) ---
RAG_LLM_MODEL=qwen3:4b
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_TEMPERATURE=0.0

# --- retrieval ---
RAG_TOP_K=3
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# --- storage ---
RAG_VECTOR_STORE_PATH=data/vector_store
RAG_PDF_PATH=data/pdfs

# --- server ---
RAG_HOST=127.0.0.1
RAG_PORT=8000
RAG_MAX_UPLOAD_MB=10

# Comma-separated list of origins allowed to call the API.
# "*" is fine locally; set real origins before exposing this anywhere.
RAG_ALLOWED_ORIGINS=*
